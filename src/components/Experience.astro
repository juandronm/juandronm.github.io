---
// Techniques: scroll-drawn timeline line, staggered card reveals, detection-box hover.
import Reveal from "./Reveal";
import ScrollLine from "./ScrollLine";
import SectionHeading from "./SectionHeading.astro";
import { t } from "../i18n";

const x = t(Astro.currentLocale).experience;
const roles = x.roles;
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeading index="01" label={x.label} title={x.title} />

  <ol class="relative mt-14 space-y-10 pl-8 sm:pl-12">
    <ScrollLine client:visible />
    {
      roles.map((entry, i) => (
        <li class="relative">
          <span
            aria-hidden="true"
            class:list={[
              "absolute top-7 -left-8 grid size-[15px] place-items-center rounded-full border-2 border-accent bg-bg sm:-left-12",
              entry.current && "shadow-[0_0_14px_var(--accent)]",
            ]}
          >
            <span class="size-1.5 rounded-full bg-accent" />
          </span>
          <Reveal delay={i * 0.1} client:visible>
            <article class="bbox bbox-hover rounded-xl border border-border bg-surface/60 p-5 transition-colors hover:border-accent/40 sm:p-8">
              <header class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <div>
                  <h3 class="text-xl font-semibold sm:text-2xl">{entry.company}</h3>
                  <p class="mt-1 text-accent">{entry.role}</p>
                </div>
                <p class="font-mono text-xs text-muted sm:text-sm">{entry.dates}</p>
              </header>
              <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted sm:text-base">
                {entry.bullets.map((bullet) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span class="[&_b]:font-medium [&_b]:text-fg" set:html={bullet} />
                  </li>
                ))}
              </ul>
              <ul class="mt-6 flex flex-wrap gap-2">
                {entry.tags.map((tag) => (
                  <li class="rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted">{tag}</li>
                ))}
              </ul>
            </article>
          </Reveal>
        </li>
      ))
    }
  </ol>
</section>
