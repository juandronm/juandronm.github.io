---
import Reveal from "./Reveal";
import MagneticButton from "./MagneticButton";

const socials = [
  { label: "Email", href: "mailto:juanronmolina@gmail.com" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/juanronmolina/" },
];
---

<section id="contact" class="mx-auto max-w-5xl px-6 py-28">
  <Reveal client:visible>
    <h2 class="font-serif text-3xl tracking-tight sm:text-4xl">Let's talk</h2>
    <p class="mt-6 max-w-md leading-relaxed text-muted">
      Currently a Computer Vision Intern at YourEye Technologies, and always open to new
      opportunities in AI, LLMs, and computer vision. The fastest way to reach me is email.
    </p>

    <div class="mt-10 flex items-center gap-6">
      <MagneticButton
        href="mailto:juanronmolina@gmail.com"
        className="inline-block rounded-full bg-fg px-7 py-3.5 text-sm font-medium text-bg transition-transform"
        client:visible
      >
        juanronmolina@gmail.com
      </MagneticButton>
    </div>

    <ul class="mt-14 flex gap-6 text-sm text-muted">
      {
        socials.map((social) => (
          <li>
            <a href={social.href} class="transition-colors hover:text-fg">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Reveal>
</section>
