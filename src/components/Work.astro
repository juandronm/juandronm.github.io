---
// Techniques: featured card with metrics strip, cursor spotlight + slight tilt (fine pointers only),
// staggered grid reveals.
import Reveal from "./Reveal";
import SectionHeading from "./SectionHeading.astro";

import { t } from "../i18n";

const w = t(Astro.currentLocale).work;
const { featured, projects } = w;
---

<section id="projects" class="border-y border-border bg-surface/40">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <SectionHeading index="02" label={w.label} title={w.title} />

    <Reveal client:visible className="mt-14">
      <article class="spotlight tilt group relative overflow-hidden rounded-2xl border border-border bg-bg p-6 transition-colors hover:border-accent/50 sm:p-10">
        <div class="grid-bg absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
        <p class="font-mono text-xs text-accent sm:text-sm">★ {w.featuredLabel} · {featured.kicker}</p>
        <h3 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{featured.title}</h3>
        <p class="mt-4 max-w-3xl leading-relaxed text-muted">{featured.description}</p>

        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-4">
          {
            featured.metrics.map((m) => (
              <div class="bg-surface p-4 sm:p-5">
                <dt class="sr-only">{m.label}</dt>
                <dd class="font-mono text-2xl font-semibold text-accent">{m.value}</dd>
                <dd class="mt-1 text-xs text-muted sm:text-sm" aria-hidden="true">{m.label}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="mt-6 flex flex-wrap gap-2">
          {featured.tags.map((tag) => (
            <li class="rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted">{tag}</li>
          ))}
        </ul>
      </article>
    </Reveal>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        projects.map((p, i) => (
          <Reveal delay={i * 0.1} client:visible className="h-full">
            <article class="spotlight tilt bbox bbox-hover flex h-full flex-col rounded-2xl border border-border bg-bg p-6 transition-colors hover:border-accent/40">
              <p class="font-mono text-xs text-muted">{p.kicker}</p>
              <h3 class="mt-3 text-xl font-semibold">{p.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{p.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {p.tags.map((tag) => (
                  <li class="rounded-md border border-border px-2 py-0.5 font-mono text-[11px] text-muted">{tag}</li>
                ))}
              </ul>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  // Spotlight follows the cursor; cards tilt a few degrees. Skipped on touch and reduced motion.
  (function () {
    if (matchMedia("(pointer: coarse)").matches) return;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll(".spotlight").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        card.style.setProperty("--x", x + "px");
        card.style.setProperty("--y", y + "px");
        if (!still && card.classList.contains("tilt")) {
          const rx = (y / r.height - 0.5) * -4, ry = (x / r.width - 0.5) * 4;
          card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        }
      });
      card.addEventListener("pointerleave", () => { card.style.transform = ""; });
    });
  })();
</script>
