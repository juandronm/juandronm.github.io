---
import Reveal from "./Reveal";

const projects = [
  {
    title: "Unmanned Ground Vehicle",
    role: "Software & Computer Vision — Dec 2025 – Present",
    description:
      "Autonomous navigation software for an intelligent ground vehicle built for the TEKNOFEST competition — a real-time monitoring and control interface, plus dataset annotation for object detection and environmental perception.",
    tags: ["Computer Vision", "Object Detection", "Data Annotation"],
    href: "#",
  },
  {
    title: "Crime Rate Factors",
    role: "Co-authored research paper — Apr 2025 – May 2025",
    description:
      "Predicted U.S. violent crime from socio-economic data (UCI Communities & Crime, 1,994 samples). Built an end-to-end ML pipeline and benchmarked 15 algorithms; the final ANN model reached 96.33% accuracy.",
    tags: ["scikit-learn", "SMOTE", "ANN"],
    href: "#",
  },
  {
    title: "MiKuri",
    role: "Solo project, OOP coursework — Nov 2024 – Dec 2024",
    description:
      "Pokémon TCG-inspired card battle game in Java — a class hierarchy modeling cards, players, decks, and battle mechanics, with a JavaFX/MVC-style interface.",
    tags: ["Java", "JavaFX", "OOP"],
    href: "#",
  },
];
---

<section id="work" class="mx-auto max-w-5xl px-6 py-28">
  <Reveal client:visible>
    <h2 class="font-serif text-3xl tracking-tight sm:text-4xl">Selected work</h2>
  </Reveal>

  <div class="mt-14 flex flex-col">
    {
      projects.map((project, i) => (
        <Reveal delay={i * 0.08} client:visible>
          <a
            href={project.href}
            class="group flex flex-col gap-4 border-t border-border py-8 transition-colors first:border-t last:border-b sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="max-w-xl">
              <h3 class="font-serif text-2xl transition-colors group-hover:text-accent">
                {project.title}
              </h3>
              <p class="mt-2 text-sm text-muted">{project.role}</p>
              <p class="mt-3 leading-relaxed text-muted">{project.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="rounded-full border border-border px-3 py-1 text-xs text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
            <span class="shrink-0 text-sm text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent">
              View →
            </span>
          </a>
        </Reveal>
      ))
    }
  </div>
</section>
