---
import Reveal from "./Reveal";

const projects = [
  {
    title: "[Project One]",
    role: "[Your role on it]",
    description:
      "[The problem it solved, in one or two sentences — what it does and why it mattered.]",
    tags: ["[Tag]", "[Tag]", "[Tag]"],
    href: "#",
  },
  {
    title: "[Project Two]",
    role: "[Your role on it]",
    description:
      "[The problem it solved, in one or two sentences — what it does and why it mattered.]",
    tags: ["[Tag]", "[Tag]"],
    href: "#",
  },
  {
    title: "[Project Three]",
    role: "[Your role on it]",
    description:
      "[The problem it solved, in one or two sentences — what it does and why it mattered.]",
    tags: ["[Tag]", "[Tag]", "[Tag]"],
    href: "#",
  },
];
---

<section id="work" class="mx-auto max-w-5xl px-6 py-28">
  <Reveal client:visible>
    <h2 class="font-serif text-3xl tracking-tight sm:text-4xl">Selected work</h2>
  </Reveal>

  <div class="mt-14 flex flex-col">
    {
      projects.map((project, i) => (
        <Reveal delay={i * 0.08} client:visible>
          <a
            href={project.href}
            class="group flex flex-col gap-4 border-t border-border py-8 transition-colors first:border-t last:border-b sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="max-w-xl">
              <h3 class="font-serif text-2xl transition-colors group-hover:text-accent">
                {project.title}
              </h3>
              <p class="mt-2 text-sm text-muted">{project.role}</p>
              <p class="mt-3 leading-relaxed text-muted">{project.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="rounded-full border border-border px-3 py-1 text-xs text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
            <span class="shrink-0 text-sm text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent">
              View →
            </span>
          </a>
        </Reveal>
      ))
    }
  </div>
</section>
