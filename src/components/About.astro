---
import Reveal from "./Reveal";

const skills = [
  "Python",
  "TensorFlow",
  "scikit-learn",
  "OpenCV",
  "YOLO",
  "HuggingFace",
  "MediaPipe",
  "Flask",
  "SQL",
  "Git",
];

const languages = [
  "Spanish (native)",
  "English (bilingual)",
  "Turkish (professional)",
  "French (basic)",
];
---

<section id="about" class="border-t border-border bg-surface/50">
  <div class="mx-auto max-w-5xl px-6 py-28">
    <Reveal client:visible>
      <h2 class="font-serif text-3xl tracking-tight sm:text-4xl">About</h2>
      <p class="mt-6 max-w-2xl leading-relaxed text-muted">
        I'm a fourth-year Computer Engineering student at Gazi University in Ankara,
        Türkiye, on a full scholarship. I care about building systems that combine
        perception and language — from real-time computer vision on security cameras to
        LLM-powered conversational tools — and I learn fastest by shipping projects
        end-to-end rather than staying in notebooks.
      </p>
    </Reveal>

    <div class="mt-16 grid gap-12 sm:grid-cols-3">
      <Reveal client:visible>
        <p class="text-sm tracking-wide text-muted">Education</p>
        <div class="mt-4">
          <p class="font-serif text-xl">Gazi University</p>
          <p class="mt-1 text-sm text-muted">B.E. Computer Engineering</p>
          <p class="mt-1 text-sm text-muted">Sep 2023 – Jul 2027 · GPA 3.41/4.00</p>
          <p class="mt-3 text-sm text-muted">Turkish Scholarships recipient — fully funded</p>
        </div>
      </Reveal>

      <Reveal delay={0.08} client:visible>
        <p class="text-sm tracking-wide text-muted">Languages</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            languages.map((language) => (
              <li class="rounded-full border border-border bg-bg px-3 py-1.5 text-sm text-fg">
                {language}
              </li>
            ))
          }
        </ul>
      </Reveal>

      <Reveal delay={0.16} client:visible>
        <p class="text-sm tracking-wide text-muted">Tools & stack</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            skills.map((skill) => (
              <li class="rounded-full border border-border bg-bg px-3 py-1.5 text-sm text-fg">
                {skill}
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>
  </div>
</section>
