---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#work", label: "Work" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="#" class="font-serif text-xl tracking-tight">
      Juan Diego Ron Molina
    </a>

    <div class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 text-sm text-muted sm:flex">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
