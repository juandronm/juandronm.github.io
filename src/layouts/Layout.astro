---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Juan Diego Ron Molina — AI Engineer · Computer Vision & Agentic LLMs",
  description = "Juan Diego Ron Molina, AI Engineer at YourEye Technologies and Computer Engineering student at Gazi University. Computer vision, TensorRT deployment, and agentic LLM systems.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07090c" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased selection:bg-accent/25 selection:text-fg">
    <slot />
  </body>
</html>
