---
import "../styles/global.css";
import { getLang, langs, pathFor, ui } from "../i18n";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const { title = ui[lang].meta.title, description = ui[lang].meta.description } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07090c" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased selection:bg-accent/25 selection:text-fg">
    <slot />
  </body>
</html>
